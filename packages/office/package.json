{
  "name": "@doffi/office",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Bounded document ZIP adapters and native DOCX/PPTX import/export",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "COMMERCIAL-LICENSE.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch --project tsconfig.json --preserveWatchOutput",
    "prepack": "node ../../scripts/prepare-package-licenses.mjs"
  },
  "dependencies": {
    "@doffi/core": "workspace:*",
    "@noble/hashes": "2.4.0",
    "css-tree": "3.2.1",
    "fflate": "0.8.3",
    "parse5": "8.0.1",
    "saxes": "6.0.0"
  },
  "devDependencies": {
    "@types/css-tree": "3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobotSe7en/doffi.git",
    "directory": "packages/office"
  }
}
