{
  "name": "@doffi/editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Document workbench with preview, annotations, request/proposal review and optional React integration",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "COMMERCIAL-LICENSE.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch --project tsconfig.json --preserveWatchOutput",
    "prepack": "node ../../scripts/prepare-package-licenses.mjs"
  },
  "dependencies": {
    "@doffi/core": "workspace:*",
    "@doffi/render": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobotSe7en/doffi.git",
    "directory": "packages/editor"
  }
}
