{
  "name": "@dagent-office/node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Managed Chromium rendering, PDF and PNG export, and bounded byte conversion protocol",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch --project tsconfig.json --preserveWatchOutput"
  },
  "dependencies": {
    "@dagent-office/core": "workspace:*",
    "@dagent-office/office": "workspace:*",
    "@dagent-office/render": "workspace:*",
    "playwright-core": "1.64.1"
  },
  "bin": {
    "dagent-office": "./dist/cli.js"
  }
}
