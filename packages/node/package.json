{
  "name": "@doffi/node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Managed Chromium rendering, PDF and PNG export, and bounded byte conversion protocol",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "COMMERCIAL-LICENSE.md"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "import": "./dist/dev.js"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --watch --project tsconfig.json --preserveWatchOutput",
    "prepack": "node ../../scripts/prepare-package-licenses.mjs"
  },
  "dependencies": {
    "@doffi/core": "workspace:*",
    "@doffi/office": "workspace:*",
    "@doffi/render": "workspace:*",
    "playwright-core": "1.64.1"
  },
  "bin": {
    "doffi": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobotSe7en/doffi.git",
    "directory": "packages/node"
  }
}
