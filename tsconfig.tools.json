{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "*.config.ts",
    "tests/**/*.ts",
    "packages/*/tests/**/*.ts",
    "scripts/**/*.mjs"
  ]
}
